// VaultFlowCore.xcconfig — the VaultFlowCore.framework target.
// VaultFlowCore is pure Foundation + system crypto (CryptoKit, CommonCrypto,
// Security, LocalAuthentication), exactly as declared in Package.swift's
// linkerSettings; frameworks are added with `import` so no OTHER_LDFLAGS are
// needed.
#include "VaultFlow.xcconfig"

PRODUCT_NAME = VaultFlowCore
PRODUCT_BUNDLE_IDENTIFIER = com.vaultflow.macos.VaultFlowCore
CURRENT_PROJECT_VERSION = 300
MARKETING_VERSION = 3.0
GENERATE_INFOPLIST_FILE = YES
DEFINES_MODULE = YES
SKIP_INSTALL = YES
