// VaultFlowCoreTests.xcconfig — the headless unit-test bundle.
// Tests run without a host application (swift test parity) and link the
// XCTest framework from the macOS platform directory.
#include "VaultFlow.xcconfig"

PRODUCT_NAME = VaultFlowCoreTests
PRODUCT_BUNDLE_IDENTIFIER = com.vaultflow.macos.VaultFlowCoreTests
CURRENT_PROJECT_VERSION = 300
MARKETING_VERSION = 3.0
GENERATE_INFOPLIST_FILE = YES
BUNDLE_LOADER =
TEST_HOST =
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks
OTHER_LDFLAGS = $(inherited) -framework XCTest
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(PLATFORM_DIR)/Developer/Library/Frameworks"
